{
    "version": 2,
    "builds": [
        {
            "src": "packages/backend/server/src/vercel-handler.ts",
            "use": "@vercel/node"
        },
        {
            "src": "package.json",
            "use": "@vercel/static-build",
            "config": {
                "distDir": "packages/frontend/apps/web/dist"
            }
        }
    ],
    "routes": [
        {
            "src": "/api/(.*)",
            "dest": "packages/backend/server/src/vercel-handler.ts"
        },
        {
            "src": "/graphql",
            "dest": "packages/backend/server/src/vercel-handler.ts"
        },
        {
            "handle": "filesystem"
        },
        {
            "src": "/(.*)",
            "dest": "/index.html"
        }
    ]
}